#include <stdio.h>

int visited[10]; 
int graph[10][10]; 
int n; 

void DFS(int i) {
    int j;
    printf("%d ", i); 
    visited[i] = 1; 

    for (j = 0; j < n; j++) {
        if (graph[i][j] == 1 && !visited[j]) {
            DFS(j); 
        }
    }
}

int main() {
    int i, j;
    printf("Dugum sayisini girin: ");
    scanf("%d", &n);

    printf("Komşuluk matrisini girin (0 veya 1):\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &graph[i][j]);
        }
    }

    for (i = 0; i < n; i++) visited[i] = 0;

    printf("\nDFS Gezintisi: ");
    DFS(0); 

    return 0;
}
